:rules_000 void:exampleResource :map_event_000.
:map_event_000 rml:logicalSource :source_000;
    a rr:TriplesMap;
    rdfs:label "event".
:s_000 a rr:SubjectMap.
:map_event_000 rr:subjectMap :s_000.
:s_000 rr:template "http://www.example.com/{eventID}".
:pom_000 a rr:PredicateObjectMap.
:map_event_000 rr:predicateObjectMap :pom_000.
:pm_000 a rr:PredicateMap.
:pom_000 rr:predicateMap :pm_000.
:pm_000 rr:constant rdf:type.
:pom_000 rr:objectMap :om_000.
:om_000 a rr:ObjectMap;
    rr:constant ex:Event;
    rr:termType rr:IRI.
:pom_000 rr:objectMap :om_001.
:om_001 a rr:ObjectMap;
    rr:constant prov:Activity;
    rr:termType rr:IRI.
:pom_001 a rr:PredicateObjectMap.
:map_event_000 rr:predicateObjectMap :pom_001.
:pm_001 a rr:PredicateMap.
:pom_001 rr:predicateMap :pm_001.
:pm_001 rr:constant rdfs:label.
:pom_001 rr:objectMap :om_002.
:om_002 a rr:ObjectMap;
    rml:reference "name";
    rr:termType rr:Literal.
:pom_002 a rr:PredicateObjectMap.
:map_event_000 rr:predicateObjectMap :pom_002.
:pm_002 a rr:PredicateMap.
:pom_002 rr:predicateMap :pm_002.
:pm_002 rr:constant prov:wasAssociatedWith.
:pom_003 a rr:PredicateObjectMap.
:map_event_000 rr:predicateObjectMap :pom_003.
:pm_003 a rr:PredicateMap.
:pom_003 rr:predicateMap :pm_003.
:pm_003 rr:constant prov:generated.
